# Local Worker: copy this file to .dev.vars (never commit .dev.vars).
# Basic browsing and interest storage require no external credentials.
# Owner-only refresh is disabled while this value is empty.
REFRESH_OWNER_EMAIL=

# Future Gmail integration; actual subscriptions/scheduled sending are incomplete.
GMAIL_MODE=disabled
GMAIL_SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
